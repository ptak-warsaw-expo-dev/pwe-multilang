<mjml>
  <mj-head>
    <!-- ===================================================== -->
    <!-- META / PREVIEW -->
    <!-- ===================================================== -->

    <mj-title>{{notification_title}}</mj-title>
    <mj-preview>{{notification_preview}}</mj-preview>
    <mj-breakpoint width="600px" />

    <!-- ===================================================== -->
    <!-- GLOBAL MJML ATTRIBUTES -->
    <!-- ===================================================== -->

    <mj-attributes>
      <mj-all font-family="'Open Sans', Arial, Helvetica, sans-serif" />
      <mj-text color="#4a4a4a" font-size="15px" line-height="24px" />
      <mj-section padding="0" />
      <mj-column padding="0" />
    </mj-attributes>

    <!-- ===================================================== -->
    <!-- RESPONSIVE STYLES / HELPERS -->
    <!-- ===================================================== -->

    <mj-style>
      @media only screen and (max-width:600px) {
        .mobile-title div {
          font-size:18px !important;
          line-height:24px !important;
        }
      }

    </mj-style>
  </mj-head>

  <mj-body background-color="#ffffff" width="600px">

    <!-- ==================================================== -->
    <!-- MAIN CREAM CONTAINER -->
    <!-- ==================================================== -->

    <mj-wrapper padding="0">

      <!-- ==================================================== -->
      <!-- HERO / BADGE GRAFICZNY -->
      <!-- ==================================================== -->

      <mj-section padding="0">
        <mj-column>
          <mj-image
            src="[trade_fair_exhibitor_generator_header_url]"
            alt="[pwe_name_{{lang}}]"
            width="600px"
            fluid-on-mobile="true"
            padding="0"
            border-radius="16px 16px 0 0"
          />
        </mj-column>
      </mj-section>

      <!-- ==================================================== -->
      <!-- GREETING -->
      <!-- ==================================================== -->

      <mj-section background-color="#fffbf4" padding="32px 26px 0">
        <mj-column>
          <mj-text
            css-class="mobile-title"
            align="left"
            color="#1a1a1a"
            font-family="Montserrat, 'Open Sans', Arial, sans-serif"
            font-size="20px"
            line-height="26px"
            font-weight="700"
            padding="0"
          >
            {{greeting}} {name:1},
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- ==================================================== -->
      <!-- INVITATION CONTENT -->
      <!-- ==================================================== -->

      <mj-section background-color="#fffbf4" padding="16px 26px 28px">
        <mj-column>
          <mj-text
            align="left"
            color="#4a4a4a"
            font-size="15px"
            line-height="24px"
            padding="0"
          >
            {{invitation_text}}
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- ==================================================== -->
      <!-- DIVIDER -->
      <!-- ==================================================== -->

      <mj-section 
        background-color="#fffbf4" 
        padding="0 26px">
        <mj-column>
          <mj-divider 
            border-width="1px" 
            border-color="#e6ddce" 
            padding="0" />
        </mj-column>
      </mj-section>

      <!-- ==================================================== -->
      <!-- SOCIAL MEDIA -->
      <!-- ==================================================== -->

      <mj-section 
        background-color="#fffbf4" 
        padding="24px 26px">
        <mj-column>
          <mj-raw>
            <table
              role="presentation"
              cellpadding="0"
              cellspacing="0"
              border="0"
              align="center"
              style="margin:0 auto; border-collapse:collapse;"
            >
              <tr>
                <td style="padding:0 8px;">
                  <a href="[trade_fair_linkedin]" target="_blank">
                    <img
                      src="https://[trade_fair_domainadress]/wp-content/plugins/pwe-media/media/ticket/media_Business_linkedin.png"
                      alt="LinkedIn"
                      width="42"
                      height="42"
                      style="display:block; width:42px; height:42px; border:0; border-radius:50%;"
                    />
                  </a>
                </td>

                <td style="padding:0 8px;">
                  <a href="[trade_fair_facebook]" target="_blank">
                    <img
                      src="https://[trade_fair_domainadress]/wp-content/plugins/pwe-media/media/ticket/media_Business_fb.png"
                      alt="Facebook"
                      width="42"
                      height="42"
                      style="display:block; width:42px; height:42px; border:0; border-radius:50%;"
                    />
                  </a>
                </td>

                <td style="padding:0 8px;">
                  <a href="[trade_fair_youtube]" target="_blank">
                    <img
                      src="https://[trade_fair_domainadress]/wp-content/plugins/pwe-media/media/ticket/media_Business_yt.png"
                      alt="YouTube"
                      width="42"
                      height="42"
                      style="display:block; width:42px; height:42px; border:0; border-radius:50%;"
                    />
                  </a>
                </td>

                <td style="padding:0 8px;">
                  <a href="[trade_fair_instagram]" target="_blank">
                    <img
                      src="https://[trade_fair_domainadress]/wp-content/plugins/pwe-media/media/ticket/media_Business_instagram.png"
                      alt="Instagram"
                      width="42"
                      height="42"
                      style="display:block; width:42px; height:42px; border:0; border-radius:50%;"
                    />
                  </a>
                </td>
              </tr>
            </table>
          </mj-raw>
        </mj-column>
      </mj-section>

      <!-- ==================================================== -->
      <!-- DIVIDER -->
      <!-- ==================================================== -->

      <mj-section 
        background-color="#fffbf4" 
        padding="0 26px">
        <mj-column>
          <mj-divider 
            border-width="1px" 
            border-color="#e6ddce" 
            padding="0" />
        </mj-column>
      </mj-section>

      <!-- ==================================================== -->
      <!-- SIGNATURE -->
      <!-- ==================================================== -->

      <mj-section background-color="#fffbf4" padding="24px 26px 4px">
        <mj-column>
          <mj-text
            align="left"
            color="#1a1a1a"
            font-size="14px"
            line-height="22px"
            padding="0"
          >
            {{regards}}
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section background-color="#fffbf4" padding="0 26px 28px">
        <mj-column>
          <mj-text
            align="left"
            color="#9a9a9a"
            font-size="12px"
            line-height="18px"
            padding="0"
          >
            {{auto_generated_message}}
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- ==================================================== -->
      <!-- FOOTER IMAGE -->
      <!-- ==================================================== -->

      <mj-section padding="0">
        <mj-column>
          <mj-image
            src="https://warsawexpo.eu/assets/mail/footer.jpg"
            alt=""
            width="600px"
            padding="0"
          />
        </mj-column>
      </mj-section>

      <!-- ==================================================== -->
      <!-- COPYRIGHT -->
      <!-- ==================================================== -->

      <mj-section background-color="#111111" padding="18px 26px">
        <mj-column>
          <mj-text
            align="center"
            color="#ffffff"
            font-size="12px"
            line-height="19px"
            padding="0"
          >
            {{copyright}}
          </mj-text>
        </mj-column>
      </mj-section>

    </mj-wrapper>

    <!-- ==================================================== -->
    <!-- LEGAL NOTICE / PRIVACY -->
    <!-- ==================================================== -->

    <mj-wrapper background-color="#eeeeee" padding="0" border-radius="0 0 16px 16px;">
      <mj-section padding="20px 26px 24px">
        <mj-column>
          <mj-text
            css-class="footer__rodo"
            align="left"
            color="#8a8a8a"
            font-size="11px"
            line-height="18px"
            padding="0"
          >
            {{privacy_notice}}
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

  </mj-body>
</mjml>