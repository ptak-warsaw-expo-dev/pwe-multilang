<mjml>
  <mj-head>
    <!-- ===================================================== -->
    <!-- META / PREVIEW -->
    <!-- ===================================================== -->

    <mj-title>{{notification_title}}</mj-title>
    <mj-preview>{{invitation_text}}</mj-preview>
    <mj-breakpoint width="600px" />

    <!-- ===================================================== -->
    <!-- GLOBAL MJML ATTRIBUTES -->
    <!-- ===================================================== -->

    <mj-attributes>
      <mj-all font-family="'Open Sans', Arial, Helvetica, sans-serif" />
      <mj-text color="#4a4a4a" font-size="15px" line-height="24px" />
      <mj-section padding="0" />
      <mj-column padding="0" />
    </mj-attributes>

    <!-- ===================================================== -->
    <!-- RESPONSIVE STYLES / HELPERS -->
    <!-- ===================================================== -->

    <mj-style>
      @media only screen and (max-width:600px) {
        .mobile-title div {
          font-size:18px !important;
          line-height:24px !important;
        }

        .mobile-stack {
          width:100% !important;
          max-width:100% !important;
          display:block !important;
        }

        .mobile-stack-padding {
          padding-left:0 !important;
          padding-right:0 !important;
          padding-bottom:24px !important;
        }

        .qr-text div {
          text-align:center !important;
          margin-left:auto !important;
          margin-right:auto !important;
        }
      }

      .generator-icons img {
        max-width:100% !important;
        height:auto !important;
      }

      .qr-container img {
        display:block !important;
        width:180px !important;
        max-width:180px !important;
        height:auto !important;
        margin:0 auto !important;
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#ffffff" width="600px">

    <!-- ==================================================== -->
    <!-- MAIN CREAM CONTAINER -->
    <!-- ==================================================== -->

    <mj-wrapper padding="0">

      <!-- ==================================================== -->
      <!-- HERO / BADGE GRAFICZNY -->
      <!-- ==================================================== -->

      <mj-section padding="0">
        <mj-column>
          <mj-image
            src="[trade_fair_exhibitor_generator_header_url]"
            alt="[pwe_name_{{lang}}]"
            width="600px"
            fluid-on-mobile="true"
            padding="0"
            border-radius="16px 16px 0 0"
          />
        </mj-column>
      </mj-section>

      <!-- ==================================================== -->
      <!-- GREETING -->
      <!-- ==================================================== -->

      <mj-section background-color="#fffbf4" padding="32px 26px 0">
        <mj-column>
          <mj-text
            css-class="mobile-title"
            align="left"
            color="#1a1a1a"
            font-family="Montserrat, 'Open Sans', Arial, sans-serif"
            font-size="20px"
            line-height="26px"
            font-weight="700"
            padding="0"
          >
            {{greeting}} {name:1},
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- ==================================================== -->
      <!-- INVITATION CONTENT -->
      <!-- ==================================================== -->

      <mj-section background-color="#fffbf4" padding="16px 26px 28px">
        <mj-column>
          <mj-text
            align="left"
            color="#4a4a4a"
            font-size="15px"
            line-height="24px"
            padding="0"
          >
            {{invitation_text}}
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- ==================================================== -->
      <!-- CTA: DOWNLOAD BADGE -->
      <!-- ==================================================== -->

      <mj-section background-color="#fffbf4" padding="0 26px 8px">
        <mj-column>
          <mj-button
            href="https://warsawexpo.eu/assets/badge/local/loading.html?category=[trade_fair_badge]_vipgold_a6&amp;getname={name:1}&amp;firma={company:11}&amp;qrcode={pwe_qr_url_encoded name=rejestracja_gosci_wystawcow}"
            target="_blank"
            align="center"
            background-color="[trade_fair_accent]"
            color="#ffffff"
            font-size="15px"
            font-weight="700"
            line-height="20px"
            border-radius="30px"
            inner-padding="14px 32px"
            padding="0"
          >
            {{badge_link_text}}
          </mj-button>
        </mj-column>
      </mj-section>

      <!-- ==================================================== -->
      <!-- BADGE BENEFITS -->
      <!-- ==================================================== -->

      <mj-section background-color="#fffbf4" padding="36px 26px 4px">
        <mj-column>
          <mj-text
            align="center"
            color="#1a1a1a"
            font-size="15px"
            line-height="20px"
            font-weight="700"
            padding="0 0 20px"
          >
            {{entitles}}
          </mj-text>

          <mj-raw>
            <div class="generator-icons" style="text-align:center; padding:0;">
              [trade_fair_exhibitor_generator_icons]
            </div>
          </mj-raw>
        </mj-column>
      </mj-section>

      <!-- ==================================================== -->
      <!-- KALENDARZ / WIĘCEJ -->
      <!-- ==================================================== -->

      <mj-section background-color="#fffbf4" padding="28px 26px 8px">
        <mj-column css-class="mobile-stack mobile-stack-padding" width="50%" padding="0 8px 0 0">
          <mj-button
            href="{{calendar_link}}"
            target="_blank"
            align="center"
            background-color="#D6B685"
            color="#ffffff"
            font-size="13px"
            font-weight="600"
            line-height="18px"
            border-radius="24px"
            inner-padding="11px 22px"
            padding="0 0 14px"
            width="100%"
          >
            {{calendar_link_text}}
          </mj-button>

          <mj-image
            src="https://[trade_fair_domainadress]/wp-content/plugins/pwe-media/media/ticket/kalendarz.png"
            alt="Kalendarz"
            width="220px"
            padding="0"
          />
        </mj-column>

        <mj-column css-class="mobile-stack" width="50%" padding="0 0 0 8px">
          <mj-button
            href="{{more_link}}"
            target="_blank"
            align="center"
            background-color="#D6B685"
            color="#ffffff"
            font-size="13px"
            font-weight="600"
            line-height="18px"
            border-radius="24px"
            inner-padding="11px 22px"
            padding="0 0 14px"
            width="100%"
          >
            {{more_link_text}}
          </mj-button>

          <mj-table padding="0">
            <tr>
              <td valign="middle" align="center" style="padding:0 8px 0 0; width:50%;">
                <img src="https://[trade_fair_domainadress]/doc/logo-color.png" alt="Logo targów" height="46" style="display:block;width:auto;max-width:110px;height:46px;margin:0 auto;border:0;" />
              </td>
              <td valign="middle" align="center" style="padding:0 0 0 8px; width:50%;">
                <img src="https://[trade_fair_domainadress]/doc/kongres-color.png" alt="Logo kongresu" height="46" style="display:block;width:auto;max-width:110px;height:46px;margin:0 auto;border:0;" />
              </td>
            </tr>
          </mj-table>
        </mj-column>
      </mj-section>

      <!-- ==================================================== -->
      <!-- DIVIDER -->
      <!-- ==================================================== -->

      <mj-section 
        background-color="#fffbf4" 
        padding="28px 26px 0">
        <mj-column>
          <mj-divider 
            border-width="1px" 
            border-color="#e6ddce" 
            padding="0" />
        </mj-column>
      </mj-section>

      <!-- ==================================================== -->
      <!-- QR -->
      <!-- ==================================================== -->

      <mj-section
        background-color="#fffbf4"
        padding="28px 26px"
      >
        <mj-column
          css-class="mobile-stack mobile-stack-padding qr-text"
          width="55%"
          vertical-align="middle"
          padding="0 16px 0 0"
        >
          <mj-text
            align="center"
            color="#1a1a1a"
            font-size="15px"
            line-height="23px"
            font-weight="700"
            padding="0"
          >
            {{qr_text}}
          </mj-text>
        </mj-column>

        <mj-column
          css-class="mobile-stack"
          width="45%"
          vertical-align="middle"
          padding="0"
        >
          <mj-text
            css-class="qr-container"
            align="center"
            padding="0"
          >
            <div
              style="
                display:inline-block;
                border:3px solid #D6B685;
                border-radius:20px;
                padding:10px;
                line-height:0;
              "
            >
              [pwe_qr_img name="rejestracja_gosci_wystawcow"]
            </div>
          </mj-text>

          <mj-text
            align="center"
            color="#8a8a8a"
            font-size="11px"
            line-height="17px"
            padding="10px 0 0"
          >
            {{qr_blocking_text}}
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- ==================================================== -->
      <!-- DIVIDER -->
      <!-- ==================================================== -->

      <mj-section 
        background-color="#fffbf4" 
        padding="0 26px">
        <mj-column>
          <mj-divider 
            border-width="1px" 
            border-color="#e6ddce" 
            padding="0" />
        </mj-column>
      </mj-section>

      <!-- ==================================================== -->
      <!-- SOCIAL MEDIA -->
      <!-- ==================================================== -->

      <mj-section 
        background-color="#fffbf4" 
        padding="24px 26px">
        <mj-column>
          <mj-raw>
            <table
              role="presentation"
              cellpadding="0"
              cellspacing="0"
              border="0"
              align="center"
              style="margin:0 auto; border-collapse:collapse;"
            >
              <tr>
                <td style="padding:0 8px;">
                  <a href="[trade_fair_linkedin]" target="_blank">
                    <img
                      src="https://[trade_fair_domainadress]/wp-content/plugins/pwe-media/media/ticket/media_Business_linkedin.png"
                      alt="LinkedIn"
                      width="42"
                      height="42"
                      style="display:block; width:42px; height:42px; border:0; border-radius:50%;"
                    />
                  </a>
                </td>

                <td style="padding:0 8px;">
                  <a href="[trade_fair_facebook]" target="_blank">
                    <img
                      src="https://[trade_fair_domainadress]/wp-content/plugins/pwe-media/media/ticket/media_Business_fb.png"
                      alt="Facebook"
                      width="42"
                      height="42"
                      style="display:block; width:42px; height:42px; border:0; border-radius:50%;"
                    />
                  </a>
                </td>

                <td style="padding:0 8px;">
                  <a href="[trade_fair_youtube]" target="_blank">
                    <img
                      src="https://[trade_fair_domainadress]/wp-content/plugins/pwe-media/media/ticket/media_Business_yt.png"
                      alt="YouTube"
                      width="42"
                      height="42"
                      style="display:block; width:42px; height:42px; border:0; border-radius:50%;"
                    />
                  </a>
                </td>

                <td style="padding:0 8px;">
                  <a href="[trade_fair_instagram]" target="_blank">
                    <img
                      src="https://[trade_fair_domainadress]/wp-content/plugins/pwe-media/media/ticket/media_Business_instagram.png"
                      alt="Instagram"
                      width="42"
                      height="42"
                      style="display:block; width:42px; height:42px; border:0; border-radius:50%;"
                    />
                  </a>
                </td>
              </tr>
            </table>
          </mj-raw>
        </mj-column>
      </mj-section>

      <!-- ==================================================== -->
      <!-- DIVIDER -->
      <!-- ==================================================== -->

      <mj-section 
        background-color="#fffbf4" 
        padding="0 26px">
        <mj-column>
          <mj-divider 
            border-width="1px" 
            border-color="#e6ddce" 
            padding="0" />
        </mj-column>
      </mj-section>

      <!-- ==================================================== -->
      <!-- SIGNATURE -->
      <!-- ==================================================== -->

      <mj-section background-color="#fffbf4" padding="24px 26px 4px">
        <mj-column>
          <mj-text
            align="left"
            color="#1a1a1a"
            font-size="14px"
            line-height="22px"
            padding="0"
          >
            {{regards}}
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section background-color="#fffbf4" padding="0 26px 28px">
        <mj-column>
          <mj-text
            align="left"
            color="#9a9a9a"
            font-size="12px"
            line-height="18px"
            padding="0"
          >
            {{auto_generated_message}}
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- ==================================================== -->
      <!-- FOOTER IMAGE -->
      <!-- ==================================================== -->

      <mj-section padding="0">
        <mj-column>
          <mj-image
            src="https://warsawexpo.eu/assets/mail/footer.jpg"
            alt=""
            width="600px"
            padding="0"
          />
        </mj-column>
      </mj-section>

      <!-- ==================================================== -->
      <!-- COPYRIGHT -->
      <!-- ==================================================== -->

      <mj-section background-color="#111111" padding="18px 26px">
        <mj-column>
          <mj-text
            align="center"
            color="#ffffff"
            font-size="12px"
            line-height="19px"
            padding="0"
          >
            {{copyright}}
          </mj-text>
        </mj-column>
      </mj-section>

    </mj-wrapper>

    <!-- ==================================================== -->
    <!-- LEGAL NOTICE / PRIVACY -->
    <!-- ==================================================== -->

    <mj-wrapper background-color="#eeeeee" padding="0" border-radius="0 0 16px 16px;">
      <mj-section padding="20px 26px 24px">
        <mj-column>
          <mj-text
            css-class="footer__rodo"
            align="left"
            color="#8a8a8a"
            font-size="11px"
            line-height="18px"
            padding="0"
          >
            {{privacy_notice}}
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

  </mj-body>
</mjml>