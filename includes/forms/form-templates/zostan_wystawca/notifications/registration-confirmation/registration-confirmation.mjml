<mjml>
  <mj-head>
    <mj-title>{{email_title}}</mj-title>
    <mj-preview>{{email_preview}}</mj-preview>

    <mj-breakpoint width="600px" />

    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />

      <mj-text
        color="#222222"
        font-size="16px"
        line-height="22px"
      />

      <mj-section padding="0" />
      <mj-column padding="0" />
    </mj-attributes>

    <mj-style>
      .hybrid-column {
        display: inline-block !important;
        vertical-align: top !important;
        box-sizing: border-box !important;
      }

      .hybrid-column-middle {
        vertical-align: middle !important;
      }

      .hybrid-card {
        width: 100% !important;
        box-sizing: border-box !important;
      }

      .message-table {
        width: 100% !important;
      }

      .mobile-header-logo {
        width: 10% !important;
      }

      .mobile-header-date {
        width: 90% !important;
      }

      @media only screen and (max-width: 520px) {
        .main-wrapper {
          padding-left: 10px !important;
          padding-right: 10px !important;
        }

        .mobile-full {
          display: block !important;
          width: 100% !important;
          max-width: 100% !important;
        }

        .mobile-title div {
          font-size: 22px !important;
          line-height: 28px !important;
        }

        .message-logo,
        .message-copy,
        .message-socials {
          display: block !important;
          width: 100% !important;
          max-width: 100% !important;
          box-sizing: border-box !important;
          text-align: center !important;
        }

        .message-logo {
          padding: 0 0 12px !important;
        }

        .message-logo img {
          margin-left: auto !important;
          margin-right: auto !important;
        }

        .message-copy {
          padding: 0 10px 14px !important;
          font-size: 14px !important;
          line-height: 19px !important;
          text-align: center !important;
        }

        .message-socials {
          padding: 0 !important;
          text-align: center !important;
        }

        .message-socials table {
          margin-left: auto !important;
          margin-right: auto !important;
        }
      
        .hybrid-column {
          width: 100% !important;
          max-width: 100% !important;
          min-width: 100% !important;
        }

        .stat-group {
          width: 100% !important;
          max-width: 100% !important;
          min-width: 100% !important;
        }
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#ffffff">
    <mj-wrapper
      css-class="main-wrapper"
      background-color="#ffffff"
    >

      <!-- ===================================================== -->
      <!-- HEADER -->
      <!-- ===================================================== -->

      <mj-section
        background-color="[trade_fair_accent]"
        border-radius="12px"
        padding="20px"
      >
        <mj-column
          css-class="mobile-header-logo"
          width="10%"
          vertical-align="middle"
        >
          <mj-image
            src="https://[trade_fair_domainadress]/wp-content/plugins/pwe-media/media/notifications/pwe-logo-white.png"
            width="40px"
            align="left"
            padding="0"
          />
        </mj-column>

        <mj-column
          css-class="mobile-header-date"
          width="90%"
          vertical-align="middle"
        >
          <mj-text
            align="right"
            color="#d0c8d6"
            font-size="16px"
            line-height="24px"
            font-weight="700"
            padding="0"
          >
            [trade_fair_date_multilang lang='{{lang}}']
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- ===================================================== -->
      <!-- HERO -->
      <!-- ===================================================== -->

      <mj-section padding="10px 0 0">
        <mj-column>
          <mj-image
            src="https://[trade_fair_domainadress]/doc/{{hero_img_filename}}"
            padding="0"
            border-radius="10px"
          />
        </mj-column>
      </mj-section>

      <!-- ===================================================== -->
      <!-- INTRO -->
      <!-- ===================================================== -->

      <mj-section padding="20px">
        <mj-column width="500px">
          <mj-text
            css-class="mobile-title"
            align="center"
            font-size="22px"
            line-height="34px"
            font-weight="700"
            padding="10px 0"
          >
            {{title}}
          </mj-text>

          <mj-text
            align="center"
            font-size="17px"
            line-height="23px"
            padding="10px 0"
          >
            {{description}}
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- ===================================================== -->
      <!-- DATE + CTA -->
      <!-- ===================================================== -->

      <mj-section padding="10px 0">
        <mj-column width="100%">
          <mj-raw>
            <div
              style="
                width: 100%;
                font-size: 0;
                text-align: center;
              "
            >

              <!-- DATE -->

              <div
                class="hybrid-column hybrid-column-middle"
                style="
                  display: inline-block;
                  vertical-align: middle;
                  width: 50%;
                  box-sizing: border-box;
                  padding: 4px 8px;
                "
              >
                <div
                  class="hybrid-card"
                  style="
                    width: 100%;
                    box-sizing: border-box;
                    background: [trade_fair_accent];
                    border-radius: 14px;
                    padding: 29px 20px;
                  "
                >
                  <div
                    style="
                      color: #ffffff;
                      font-family: Arial, Helvetica, sans-serif;
                      font-size: 14px;
                      line-height: 20px;
                      font-weight: 600;
                      text-align: center;
                      padding: 5px 5px 10px;
                    "
                  >
                    {{event_date_text}}
                  </div>

                  <div
                    style="
                      color: #ffffff;
                      font-family: Arial, Helvetica, sans-serif;
                      font-size: 22px;
                      line-height: 28px;
                      font-weight: 700;
                      text-align: center;
                      padding: 10px 5px;
                    "
                  >
                    [trade_fair_date_multilang lang='{{lang}}']
                  </div>

                  <div
                    style="
                      text-align: center;
                      padding: 15px 0 5px;
                    "
                  >
                    <a
                      href="https://[trade_fair_domainadress]/{{add_to_calendar_url}}"
                      target="_blank"
                      style="
                        display: inline-block;
                        background: #ffffff;
                        color: [trade_fair_accent];
                        font-family: Arial, Helvetica, sans-serif;
                        font-size: 14px;
                        line-height: 20px;
                        font-weight: 700;
                        text-decoration: none;
                        padding: 12px 24px;
                        border-radius: 24px;
                      "
                    >
                      {{add_to_calendar_text}}
                    </a>
                  </div>
                </div>
              </div>

              <!-- CTA -->

              <div
                class="hybrid-column hybrid-column-middle"
                style="
                  display: inline-block;
                  vertical-align: middle;
                  width: 50%;
                  box-sizing: border-box;
                  padding: 4px 8px;
                "
              >
                <div
                  class="hybrid-card"
                  style="
                    width: 100%;
                    box-sizing: border-box;
                    border-radius: 14px;
                    padding: 20px;
                  "
                >
                  <div
                    style="
                      color: [trade_fair_accent];
                      font-family: Arial, Helvetica, sans-serif;
                      font-size: 14px;
                      line-height: 22px;
                      font-weight: 700;
                      text-align: center;
                      padding: 10px 5px;
                    "
                  >
                    {{cta_text}}
                  </div>

                  <div
                    style="
                      text-align: center;
                      padding: 15px 0;
                    "
                  >
                    <a
                      href="https://[pwe_lang_domain lang='{{lang}}']/"
                      target="_blank"
                      style="
                        display: inline-block;
                        background: [trade_fair_accent];
                        color: #ffffff;
                        font-family: Arial, Helvetica, sans-serif;
                        font-size: 14px;
                        line-height: 20px;
                        font-weight: 700;
                        text-decoration: none;
                        padding: 12px 24px;
                        border-radius: 24px;
                      "
                    >
                      {{cta_button_text}}
                    </a>
                  </div>

                  <div
                    style="
                      color: #222222;
                      font-family: Arial, Helvetica, sans-serif;
                      font-size: 16px;
                      line-height: 21px;
                      font-weight: 600;
                      text-align: center;
                      padding: 5px;
                      overflow-wrap: anywhere;
                    "
                  >
                    [pwe_lang_domain lang='{{lang}}']/
                  </div>
                </div>
              </div>

            </div>
          </mj-raw>
        </mj-column>
      </mj-section>

      <!-- ===================================================== -->
      <!-- TEAM -->
      <!-- ===================================================== -->

      <mj-section padding="20px 20px 30px">
        <mj-column>
          <mj-image
            src="https://[trade_fair_domainadress]/wp-content/plugins/pwe-media/media/notifications/pwe-team.png"
            width="110px"
            alt=""
            padding="0 0 10px"
          />

          <mj-text
            align="center"
            font-size="16px"
            line-height="22px"
            font-weight="700"
            padding="0 0 4px"
          >
            {{team_name}}
          </mj-text>

          <mj-text
            align="center"
            font-size="14px"
            line-height="18px"
            padding="0"
          >
            {{team_description}}
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- ===================================================== -->
      <!-- MESSAGE -->
      <!-- ===================================================== -->

      <mj-section padding="0 6px 16px">
        <mj-column
          width="100%"
          background-color="[trade_fair_accent]"
          border-radius="12px"
          padding="16px 20px"
        >
          <mj-table
            css-class="message-table"
            width="100%"
            padding="0"
          >
            <tr>

              <!-- LOGO -->

              <td
                class="message-logo"
                width="8%"
                valign="middle"
                align="left"
                style="
                  width: 8%;
                  padding: 0;
                  vertical-align: middle;
                  text-align: left;
                "
              >
                <img
                  src="https://[trade_fair_domainadress]/wp-content/plugins/pwe-media/media/notifications/pwe-logo-white.png"
                  width="40"
                  alt="Ptak Warsaw Expo"
                  style="
                    display: block;
                    width: 40px;
                    max-width: 40px;
                    height: auto;
                    border: 0;
                  "
                />
              </td>

              <!-- TEXT -->

              <td
                class="message-copy"
                width="60%"
                valign="middle"
                align="center"
                style="
                  width: 60%;
                  padding: 0 15px;
                  color: #ffffff;
                  font-family: Arial, Helvetica, sans-serif;
                  font-size: 15px;
                  line-height: 20px;
                  font-weight: 600;
                  vertical-align: middle;
                  text-align: left;
                "
              >
                {{community_message}}
              </td>

              <!-- SOCIALS -->

              <td
                class="message-socials"
                width="10%"
                valign="middle"
                align="center"
                style="
                  width: 10%;
                  padding: 0;
                  vertical-align: middle;
                  text-align: center;
                "
              >
                <table
                  role="presentation"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  align="center"
                  style="
                    border-collapse: collapse;
                    margin: 0 auto 0 auto;
                  "
                >
                  <tr>
                    <td style="padding: 0 4px">
                      <a
                        href="https://www.facebook.com/ptakwarsawexpo"
                        target="_blank"
                        style="
                          display: block;
                          text-decoration: none;
                        "
                      >
                        <img
                          src="https://[trade_fair_domainadress]/wp-content/plugins/pwe-media/media/notifications/facebook_icon.png"
                          width="38"
                          height="38"
                          alt="Facebook"
                          style="
                            display: block;
                            width: 38px;
                            height: 38px;
                            border: 0;
                          "
                        />
                      </a>
                    </td>

                    <td style="padding: 0 4px">
                      <a
                        href="https://www.instagram.com/ptakwarsawexpo/"
                        target="_blank"
                        style="
                          display: block;
                          text-decoration: none;
                        "
                      >
                        <img
                          src="https://[trade_fair_domainadress]/wp-content/plugins/pwe-media/media/notifications/instagram_icon.png"
                          width="38"
                          height="38"
                          alt="Instagram"
                          style="
                            display: block;
                            width: 38px;
                            height: 38px;
                            border: 0;
                          "
                        />
                      </a>
                    </td>
                  </tr>
                </table>
              </td>

            </tr>
          </mj-table>
        </mj-column>
      </mj-section>

      <!-- ===================================================== -->
      <!-- OBIEKT -->
      <!-- ===================================================== -->

      <mj-section padding="0 6px">
        <mj-column>
          <mj-image
            src="https://[trade_fair_domainadress]/wp-content/plugins/pwe-media/media/notifications/email-footer/background_footer.jpg"
            padding="0"
            border-radius="10px 10px 0 0"
          />
        </mj-column>
      </mj-section>

      <!-- ===================================================== -->
      <!-- STATYSTYKI -->
      <!-- ===================================================== -->

      <mj-section padding="0 6px">
        <mj-column width="100%" padding="12px 10px" background-color="#1e1e1e">
          <mj-raw>
            <tr>
              <td
                align="center"
                bgcolor="#1e1e1e"
                style="
                  padding: 0;
                  font-size: 0;
                  text-align: center;
                  background: #1e1e1e;
                "
              >
                <div style="width: 100%; font-size: 0; text-align: center">
                  <!-- ================================================= -->
                  <!-- GRUPA 1: STAT 1 + 2 -->
                  <!-- ================================================= -->

                  <div
                    class="stat-group"
                    style="
                      display: inline-block;
                      vertical-align: top;
                      width: 50%;
                      box-sizing: border-box;
                      text-align: center;
                    "
                  >
                    <!-- ===================== -->
                    <!-- STAT 1 -->
                    <!-- ===================== -->

                    <div
                      style="
                        display: inline-block;
                        vertical-align: top;
                        width: 50%;
                        box-sizing: border-box;
                        padding: 4px;
                      "
                    >
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        bgcolor="#1e1e1e"
                        style="
                          width: 100%;
                          border-collapse: separate;
                          border-spacing: 0;
                          background: #1e1e1e;
                          border: 1px solid #505050;
                          border-radius: 12px;
                        "
                      >
                        <tbody>
                          <tr>
                            <td
                              valign="middle"
                              bgcolor="#1e1e1e"
                              style="
                                height: 90px;
                                padding: 10px;
                                background: #1e1e1e;
                                border-radius: 12px;
                                vertical-align: middle;
                              "
                            >
                              <table
                                role="presentation"
                                width="100%"
                                cellpadding="0"
                                cellspacing="0"
                                border="0"
                                style="width: 100%; border-collapse: collapse"
                              >
                                <tbody>
                                  <tr>
                                    <td align="right" style="padding: 0 0 8px">
                                      <img
                                        src="https://[trade_fair_domainadress]/wp-content/plugins/pwe-media/media/notifications/exhibitors_icon.png"
                                        width="30"
                                        alt=""
                                        style="
                                          display: block;
                                          width: 30px;
                                          height: auto;
                                          margin-left: auto;
                                          border: 0;
                                        "
                                      />
                                    </td>
                                  </tr>

                                  <tr>
                                    <td
                                      align="left"
                                      style="
                                        padding: 0;
                                        color: #ffffff;
                                        font-family:
                                          Arial, Helvetica, sans-serif;
                                        font-size: 27px;
                                        line-height: 30px;
                                        font-weight: 700;
                                        text-align: left;
                                      "
                                    >
                                      2000+
                                    </td>
                                  </tr>

                                  <tr>
                                    <td
                                      align="left"
                                      style="
                                        padding: 3px 0 0;
                                        color: #ffffff;
                                        font-family:
                                          Arial, Helvetica, sans-serif;
                                        font-size: 9px;
                                        line-height: 12px;
                                        font-weight: 700;
                                        text-align: left;
                                      "
                                    >
                                      {{exhibitors_text}}
                                    </td>
                                  </tr>
                                </tbody>
                              </table>
                            </td>
                          </tr>
                        </tbody>
                      </table>
                    </div>

                    <!-- ===================== -->
                    <!-- STAT 2 -->
                    <!-- ===================== -->

                    <div
                      style="
                        display: inline-block;
                        vertical-align: top;
                        width: 50%;
                        box-sizing: border-box;
                        padding: 4px;
                      "
                    >
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        bgcolor="#1e1e1e"
                        style="
                          width: 100%;
                          border-collapse: separate;
                          border-spacing: 0;
                          background: #1e1e1e;
                          border: 1px solid #505050;
                          border-radius: 12px;
                        "
                      >
                        <tbody>
                          <tr>
                            <td
                              valign="middle"
                              bgcolor="#1e1e1e"
                              style="
                                height: 90px;
                                padding: 10px;
                                background: #1e1e1e;
                                border-radius: 12px;
                                vertical-align: middle;
                              "
                            >
                              <table
                                role="presentation"
                                width="100%"
                                cellpadding="0"
                                cellspacing="0"
                                border="0"
                                style="width: 100%; border-collapse: collapse"
                              >
                                <tbody>
                                  <tr>
                                    <td align="right" style="padding: 0 0 8px">
                                      <img
                                        src="https://[trade_fair_domainadress]/wp-content/plugins/pwe-media/media/notifications/visitors_icon.png"
                                        width="30"
                                        alt=""
                                        style="
                                          display: block;
                                          width: 30px;
                                          height: auto;
                                          margin-left: auto;
                                          border: 0;
                                        "
                                      />
                                    </td>
                                  </tr>

                                  <tr>
                                    <td
                                      align="left"
                                      style="
                                        padding: 0;
                                        color: #ffffff;
                                        font-family:
                                          Arial, Helvetica, sans-serif;
                                        font-size: 27px;
                                        line-height: 30px;
                                        font-weight: 700;
                                        text-align: left;
                                      "
                                    >
                                      1 mln+
                                    </td>
                                  </tr>

                                  <tr>
                                    <td
                                      align="left"
                                      style="
                                        padding: 3px 0 0;
                                        color: #ffffff;
                                        font-family:
                                          Arial, Helvetica, sans-serif;
                                        font-size: 9px;
                                        line-height: 12px;
                                        font-weight: 700;
                                        text-align: left;
                                      "
                                    >
                                      {{visitors_text}}
                                    </td>
                                  </tr>
                                </tbody>
                              </table>
                            </td>
                          </tr>
                        </tbody>
                      </table>
                    </div>
                  </div>

                  <!-- ================================================= -->
                  <!-- GRUPA 2: STAT 3 + 4 -->
                  <!-- ================================================= -->

                  <div
                    class="stat-group"
                    style="
                      display: inline-block;
                      vertical-align: top;
                      width: 50%;
                      box-sizing: border-box;
                      text-align: center;
                    "
                  >
                    <!-- ===================== -->
                    <!-- STAT 3 -->
                    <!-- ===================== -->

                    <div
                      style="
                        display: inline-block;
                        vertical-align: top;
                        width: 50%;
                        box-sizing: border-box;
                        padding: 4px;
                      "
                    >
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        bgcolor="#1e1e1e"
                        style="
                          width: 100%;
                          border-collapse: separate;
                          border-spacing: 0;
                          background: #1e1e1e;
                          border: 1px solid #505050;
                          border-radius: 12px;
                        "
                      >
                        <tbody>
                          <tr>
                            <td
                              valign="middle"
                              bgcolor="#1e1e1e"
                              style="
                                height: 90px;
                                padding: 10px;
                                background: #1e1e1e;
                                border-radius: 12px;
                                vertical-align: middle;
                              "
                            >
                              <table
                                role="presentation"
                                width="100%"
                                cellpadding="0"
                                cellspacing="0"
                                border="0"
                                style="width: 100%; border-collapse: collapse"
                              >
                                <tbody>
                                  <tr>
                                    <td align="right" style="padding: 0 0 8px">
                                      <img
                                        src="https://[trade_fair_domainadress]/wp-content/plugins/pwe-media/media/notifications/email-footer/fairs_icon.png"
                                        width="30"
                                        alt=""
                                        style="
                                          display: block;
                                          width: 30px;
                                          height: auto;
                                          margin-left: auto;
                                          border: 0;
                                        "
                                      />
                                    </td>
                                  </tr>

                                  <tr>
                                    <td
                                      align="left"
                                      style="
                                        padding: 0;
                                        color: #ffffff;
                                        font-family:
                                          Arial, Helvetica, sans-serif;
                                        font-size: 27px;
                                        line-height: 30px;
                                        font-weight: 700;
                                        text-align: left;
                                      "
                                    >
                                      140+
                                    </td>
                                  </tr>

                                  <tr>
                                    <td
                                      align="left"
                                      style="
                                        padding: 3px 0 0;
                                        color: #ffffff;
                                        font-family:
                                          Arial, Helvetica, sans-serif;
                                        font-size: 9px;
                                        line-height: 12px;
                                        font-weight: 700;
                                        text-align: left;
                                      "
                                    >
                                      {{fairs_text}}
                                    </td>
                                  </tr>
                                </tbody>
                              </table>
                            </td>
                          </tr>
                        </tbody>
                      </table>
                    </div>

                    <!-- ===================== -->
                    <!-- STAT 4 -->
                    <!-- ===================== -->

                    <div
                      style="
                        display: inline-block;
                        vertical-align: top;
                        width: 50%;
                        box-sizing: border-box;
                        padding: 4px;
                      "
                    >
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        bgcolor="#1e1e1e"
                        style="
                          width: 100%;
                          border-collapse: separate;
                          border-spacing: 0;
                          background: #1e1e1e;
                          border: 1px solid #505050;
                          border-radius: 12px;
                        "
                      >
                        <tbody>
                          <tr>
                            <td
                              valign="middle"
                              bgcolor="#1e1e1e"
                              style="
                                height: 90px;
                                padding: 10px;
                                background: #1e1e1e;
                                border-radius: 12px;
                                vertical-align: middle;
                              "
                            >
                              <table
                                role="presentation"
                                width="100%"
                                cellpadding="0"
                                cellspacing="0"
                                border="0"
                                style="width: 100%; border-collapse: collapse"
                              >
                                <tbody>
                                  <tr>
                                    <td align="right" style="padding: 0 0 8px">
                                      <img
                                        src="https://[trade_fair_domainadress]/wp-content/plugins/pwe-media/media/notifications/email-footer/area_icon.png"
                                        width="30"
                                        alt=""
                                        style="
                                          display: block;
                                          width: 30px;
                                          height: auto;
                                          margin-left: auto;
                                          border: 0;
                                        "
                                      />
                                    </td>
                                  </tr>

                                  <tr>
                                    <td
                                      align="left"
                                      style="
                                        padding: 0;
                                        color: #ffffff;
                                        font-family:
                                          Arial, Helvetica, sans-serif;
                                        font-size: 27px;
                                        line-height: 30px;
                                        font-weight: 700;
                                        text-align: left;
                                      "
                                    >
                                      153 k
                                    </td>
                                  </tr>

                                  <tr>
                                    <td
                                      align="left"
                                      style="
                                        padding: 3px 0 0;
                                        color: #ffffff;
                                        font-family:
                                          Arial, Helvetica, sans-serif;
                                        font-size: 9px;
                                        line-height: 12px;
                                        font-weight: 700;
                                        text-align: left;
                                      "
                                    >
                                      {{area_text}}
                                    </td>
                                  </tr>
                                </tbody>
                              </table>
                            </td>
                          </tr>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </td>
            </tr>
          </mj-raw>
        </mj-column>
      </mj-section>

      <!-- ===================================================== -->
      <!-- RODO -->
      <!-- ===================================================== -->

      <mj-section padding="0 6px 10px">
        <mj-column
          background-color="#1e1e1e"
          border-radius="0 0 14px 14px"
          padding="6px 16px 16px"
        >
          <mj-text
            color="#ffffff"
            font-size="9px"
            line-height="13px"
            padding="0"
            align="left"
          >
            {{rodo_text}}
            <a
              href="mailto:rodo@warsawexpo.eu"
              style="color: #ffffff; text-decoration: underline"
            >
              rodo@warsawexpo.eu </a
            >.
          </mj-text>
        </mj-column>
      </mj-section>

    </mj-wrapper>
  </mj-body>
