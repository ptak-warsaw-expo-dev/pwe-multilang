      <!-- ===================================================== -->
      <!-- LOGO + SOCIAL -->
      <!-- ===================================================== -->

      <mj-section padding="0 6px">
        <mj-column width="100%" padding="12px 16px" background-color="#1e1e1e">
          <mj-table padding="0">
            <tr>
              <!-- LOGO -->
              <td
                width="50%"
                valign="middle"
                align="left"
                style="
                  width: 50%;
                  vertical-align: middle;
                  text-align: left;
                  padding: 0;
                "
              >
                <img
                  src="https://[trade_fair_domainadress]/wp-content/plugins/pwe-media/media/notifications/email-footer/pwe-logo-white.png"
                  width="50"
                  alt=""
                  style="
                    display: block;
                    width: 50px;
                    max-width: 50px;
                    height: auto;
                    border: 0;
                  "
                />
              </td>

              <!-- SOCIAL -->
              <td
                width="50%"
                valign="middle"
                align="right"
                style="
                  width: 50%;
                  vertical-align: middle;
                  text-align: right;
                  padding: 0;
                "
              >
                <table
                  role="presentation"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  align="right"
                  style="border-collapse: collapse; margin-left: auto"
                >
                  <tr>
                    <!-- FACEBOOK -->
                    <td valign="middle" style="padding: 0 6px 0 0">
                      <a
                        href="[pwe_facebook]"
                        target="_blank"
                        style="display: block; text-decoration: none"
                      >
                        <img
                          src="https://[trade_fair_domainadress]/wp-content/plugins/pwe-media/media/notifications/email-footer/facebook_icon.png"
                          width="38"
                          height="38"
                          alt="Facebook"
                          style="
                            display: block;
                            width: 38px;
                            height: 38px;
                            border: 0;
                            background: #1e1e1e;
                            border-radius: 8px;
                          "
                        />
                      </a>
                    </td>

                    <!-- INSTAGRAM -->
                    <td valign="middle" style="padding: 0">
                      <a
                        href="[pwe_instagram]"
                        target="_blank"
                        style="display: block; text-decoration: none"
                      >
                        <img
                          src="https://[trade_fair_domainadress]/wp-content/plugins/pwe-media/media/notifications/email-footer/instagram_icon.png"
                          width="38"
                          height="38"
                          alt="Instagram"
                          style="
                            display: block;
                            width: 38px;
                            height: 38px;
                            border: 0;
                            background: #1e1e1e;
                            border-radius: 8px;
                          "
                        />
                      </a>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </mj-table>
        </mj-column>
      </mj-section>

      <!-- ===================================================== -->
      <!-- RODO -->
      <!-- ===================================================== -->

      <mj-section padding="0 6px 10px">
        <mj-column
          background-color="#1e1e1e"
          border-radius="0 0 5px 5px"
          padding="6px 16px 16px"
        >
          <mj-text
            color="#ffffff"
            font-size="9px"
            line-height="13px"
            padding="0"
            align="left"
          >
            {{rodo_text}}
            <a
              href="mailto:rodo@warsawexpo.eu"
              style="color: #ffffff; text-decoration: underline"
            >
              rodo@warsawexpo.eu </a
            >.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
