<mjml>
  <mj-head>
    <mj-title>{{email_title}}</mj-title>
    <mj-preview>{{email_preview}}</mj-preview>

    <!-- Nadal przydatne dla faktycznych urządzeń mobilnych -->
    <mj-breakpoint width="600px" />

    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />

      <mj-text color="#222222" font-size="16px" line-height="22px" />

      <mj-section padding="0" />
      <mj-column padding="0" />
    </mj-attributes>

    <mj-style>
      .mobile-header-logo { width: 10% !important; } .mobile-header-date {
      width: 90% !important; } /* * Breakpoint pozostaje jako dodatkowe
      zabezpieczenie * dla prawdziwego mobile. * * QR/CTA i benefity NIE
      polegają już na nim do wrapowania. */ @media only screen and
      (max-width:600px) { .mobile-full { width: 100% !important; max-width: 100%
      !important; display: block !important; } .mobile-title div { font-size:
      22px !important; line-height: 28px !important; } .mobile-date div {
      font-size: 18px !important; line-height: 24px !important; } .stat-card {
      width:50% !important; max-width:50% !important; } .vip-benefit-cell,
      .vip-benefit-cell-4 {padding: 4px 0 !important; } } @media only screen and
      (max-width:300px) { .stat-card { width:100% !important; max-width:100%
      !important; } } .qr-wrap img { display: block !important; width: auto
      !important; max-width: 100% !important; height: auto !important;
      margin-left: auto !important; margin-right: auto !important; }
      .hybrid-cell { display: table-cell !important; } @media only screen and
      (max-width:600px) { .hybrid-cell { display: block !important; width: 100%
      !important; } } .hybrid-column { display: inline-block !important;
      vertical-align: top !important; width: 100% !important; max-width: 270px
      !important; min-width: 250px !important; box-sizing: border-box
      !important; } .hybrid-column-middle { vertical-align: middle !important; }
      .hybrid-card { box-sizing: border-box !important; width: 100% !important;
      } .benefit-item { width: 50% !important; max-width: 50% !important;
      min-width: 0 !important; padding: 4px !important; } @media only screen and
      (max-width:600px) { .benefit-item { width: 100% !important; max-width:
      100% !important; } } @media only screen and (max-width:600px) {
      .vip-benefit-cell { display: block !important; width: 100% !important; } }
      @media only screen and (max-width: 520px) { .stat-group { width: 100%
      !important; max-width: 100% !important; min-width: 100% !important; } }
    </mj-style>
  </mj-head>

  <mj-body background-color="#ffffff">
    <!-- ===================================================== -->
    <!-- GŁÓWNY WRAPPER -->
    <!-- ===================================================== -->

    <mj-wrapper padding="0" css-class="main-wrapper">
      <!-- ===================================================== -->
      <!-- HEADER -->
      <!-- ===================================================== -->

      <mj-section
        background-color="[trade_fair_accent]"
        border-radius="12px"
        padding="20px"
      >
        <mj-column
          css-class="mobile-header-logo"
          width="10%"
          vertical-align="middle"
        >
          <mj-image
            src="https://[trade_fair_domainadress]/wp-content/plugins/pwe-media/media/notifications/pwe-logo-white.png"
            width="40px"
            align="left"
            padding="0"
          />
        </mj-column>

        <mj-column
          css-class="mobile-header-date"
          width="90%"
          vertical-align="middle"
        >
          <mj-text
            align="right"
            color="#ffffff"
            font-size="18px"
            line-height="24px"
            font-weight="400"
            padding="0"
          >
            {{email_title}}
          </mj-text>
          <mj-text
            align="right"
            color="#d0c8d6"
            font-size="14px"
            line-height="24px"
            font-weight="700"
            padding="0"
          >
            [trade_fair_date_multilang lang='{{lang}}']
          </mj-text>
        </mj-column>
      </mj-section>

    </mj-wrapper>
    <mj-wrapper padding="10px 0">

      <!-- ===================================================== -->
      <!-- HERO -->
      <!-- ===================================================== -->

      <mj-section
        background-url="https://[trade_fair_domainadress]/wp-content/plugins/pwe-media/media/notifications/cc_platyna/header_background.jpg"
        border-radius="10px"
        padding="0"
        padding-bottom="40px"
        background-size="cover"
      >
        <mj-column width="100%" padding="0" vertical-align="top">
          <mj-image
            src="https://[trade_fair_domainadress]/wp-content/plugins/pwe-media/media/notifications/cc_platyna/header_logo_pwe.png"
            width="32px"
            align="right"
            padding-right="5px"
            padding-top="5px"
            padding-bottom="0"
          />
        </mj-column>
        <mj-column width="100%">
          <mj-text
            color="#ffffff"
            align="center"
            font-size="18px"
            letter-spacing="1px"
            padding-top="15px"
            padding-bottom="2px"
          >
            {{hero_title}}
          </mj-text>
        </mj-column>
        <mj-group width="100%">
          <mj-column width="50%" vertical-align="middle" padding="0">
            <mj-image
              src="https://[trade_fair_domainadress]/wp-content/plugins/pwe-media/media/notifications/cc_platyna/header_vip_icon.png"
              width="180px"
              align="right"
              padding-right="5px"
            />
          </mj-column>
          <mj-column width="50%" vertical-align="middle" padding="0">
            <mj-image
              src="https://[trade_fair_domainadress]/doc/{{hero_logo}}"
              width="180px"
              align="left"
              padding-left="5px"
            />
          </mj-column>
        </mj-group>
      </mj-section>

      <!-- ===================================================== -->
      <!-- INTRO -->
      <!-- ===================================================== -->

      <mj-section padding="20px">
        <mj-column css-class="mobile-full">
          <mj-text
            css-class="mobile-title"
            align="center"
            font-size="22px"
            line-height="34px"
            font-weight="700"
            padding="10px 0"
          >
            {{title}}<br />
          </mj-text>

          <mj-text
            align="center"
            font-size="16px"
            line-height="23px"
            padding="10px 0"
          >
            {{description}}
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- ===================================================== -->
      <!-- VIP BENEFITS -->
      <!-- ===================================================== -->

      <mj-section padding="10px 12px 20px">
        <mj-column>
          <mj-text
            align="center"
            color="#1E222B"
            font-size="22px"
            line-height="24px"
            font-weight="700"
            padding="0"
          >
            {{benefits_title}}
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding="0 6px 15px">
        <mj-column>
          <mj-raw>
            <table
              role="presentation"
              width="100%"
              cellpadding="0"
              cellspacing="0"
              border="0"
              style="width: 100%; border-collapse: collapse"
            >
              <tr>
                <td
                  class="vip-benefit-cell"
                  width="33.33%"
                  valign="top"
                  style="width: 33.33%; padding: 4px; vertical-align: top"
                >
                  <div
                    style="
                      background: [trade_fair_accent];
                      border-radius: 5px;
                      padding: 20px 14px;
                      text-align: center;
                    "
                  >
                    <img
                      src="https://[trade_fair_domainadress]/wp-content/plugins/pwe-media/media/notifications/registration-platyna/door-icon.png"
                      height="50"
                      alt=""
                      style="
                        display: block;
                        height: 50px;
                        max-width: 100%;
                        width: auto;
                        margin: 0 auto 8px;
                        border: 0;
                      "
                    />
                    <div
                      style="
                        color: #ffffff;
                        font-family: Arial, Helvetica, sans-serif;
                        font-size: 18px;
                        line-height: 24px;
                        font-weight: 700;
                        padding: 8px 0 6px;
                      "
                    >
                      {{benefit_1}}
                    </div>
                  </div>
                </td>
                <td
                  class="vip-benefit-cell"
                  width="33.33%"
                  valign="top"
                  style="width: 33.33%; padding: 4px; vertical-align: top"
                >
                  <div
                    style="
                      background: [trade_fair_accent];
                      border-radius: 5px;
                      padding: 20px 14px;
                      text-align: center;
                    "
                  >
                    <img
                      src="https://[trade_fair_domainadress]/wp-content/plugins/pwe-media/media/notifications/registration-platyna/concierge-icon.png"
                      height="50"
                      alt=""
                      style="
                        display: block;
                        height: 50px;
                        max-width: 100%;
                        width: auto;
                        margin: 0 auto 8px;
                        border: 0;
                      "
                    />
                    <div
                      style="
                        color: #ffffff;
                        font-family: Arial, Helvetica, sans-serif;
                        font-size: 18px;
                        line-height: 24px;
                        font-weight: 700;
                        padding: 8px 0 6px;
                      "
                    >
                      {{benefit_2}}
                    </div>
                  </div>
                </td>
                <td
                  class="vip-benefit-cell"
                  width="33.33%"
                  valign="top"
                  style="width: 33.33%; padding: 4px; vertical-align: top"
                >
                  <div
                    style="
                      background: [trade_fair_accent];
                      border-radius: 5px;
                      padding: 20px 14px;
                      text-align: center;
                    "
                  >
                    <img
                      src="https://[trade_fair_domainadress]/wp-content/plugins/pwe-media/media/notifications/registration-platyna/vip-icon.png"
                      height="50"
                      alt=""
                      style="
                        display: block;
                        height: 50px;
                        max-width: 100%;
                        width: auto;
                        margin: 0 auto 8px;
                        border: 0;
                      "
                    />
                    <div
                      style="
                        color: #ffffff;
                        font-family: Arial, Helvetica, sans-serif;
                        font-size: 18px;
                        line-height: 24px;
                        font-weight: 700;
                        padding: 8px 0 6px;
                      "
                    >
                      {{benefit_3}}
                    </div>
                  </div>
                </td>
              </tr>
              <tr>
                <td
                  class="vip-benefit-cell-4"
                  colspan="3"
                  valign="top"
                  style="padding: 4px; vertical-align: top"
                >
                  <div
                    style="
                      background: [trade_fair_accent];
                      border-radius: 5px;
                      padding: 20px 14px;
                      text-align: center;
                    "
                  >
                    <img
                      src="https://[trade_fair_domainadress]/wp-content/plugins/pwe-media/media/notifications/registration-platyna/conference-icon.png"
                      height="50"
                      alt=""
                      style="
                        display: block;
                        height: 50px;
                        max-width: 100%;
                        width: auto;
                        margin: 0 auto 8px;
                        border: 0;
                      "
                    />
                    <div
                      style="
                        color: #ffffff;
                        font-family: Arial, Helvetica, sans-serif;
                        font-size: 18px;
                        line-height: 24px;
                        font-weight: 700;
                        padding: 8px 0 6px;
                      "
                    >
                      {{benefit_4}}
                    </div>
                  </div>
                </td>
              </tr>
            </table>
          </mj-raw>
        </mj-column>
      </mj-section>

      <!-- ===================================================== -->
      <!-- QR + CTA -->
      <!-- ===================================================== -->
      <!--
        HYBRID LAYOUT

        Każdy element:
        min-width: 250px
        max-width: 270px

        Dzięki temu Outlook Web może zawinąć elementy
        zależnie od szerokości panelu wiadomości.
      -->

      <mj-section padding="20px 12px">
        <mj-column>
          <mj-text
            align="center"
            color="#1E222B"
            font-size="22px"
            line-height="24px"
            font-weight="700"
          >
            {{join_us}}
          </mj-text>
          <mj-text
            align="center"
            color="#4F5B6E"
            font-size="14px"
            line-height="24px"
            font-weight="400"
            padding="0"
          >
            {{show_qr_instructions}}
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding="15px 6px">
        <mj-column width="100%">
          <mj-raw>
            <table
              role="presentation"
              width="100%"
              cellpadding="0"
              cellspacing="0"
              border="0"
              style="width: 100%; border-collapse: collapse"
            >
              <tr>
                <!-- ============================================= -->
                <!-- QR -->
                <!-- ============================================= -->

                <td
                  class="hybrid-cell"
                  width="50%"
                  valign="top"
                  style="
                    display: table-cell;
                    width: 50%;
                    vertical-align: top;
                    box-sizing: border-box;
                    padding: 4px;
                  "
                >
                  <table
                    role="presentation"
                    width="100%"
                    height="100%"
                    cellpadding="0"
                    cellspacing="0"
                    border="0"
                    style="
                      width: 100%;
                      height: 100%;
                      box-sizing: border-box;
                      background: [trade_fair_accent];
                      border-radius: 5px;
                    "
                  >
                    <tr>
                      <td
                        valign="top"
                        style="
                          height: 100%;
                          padding: 14px;
                          background: [trade_fair_accent];
                          border-radius: 5px;
                        "
                      >
                        <div
                          style="
                            color: #ffffff;
                            font-family: Arial, Helvetica, sans-serif;
                            font-size: 16px;
                            line-height: 21px;
                            font-weight: 700;
                            text-align: center;
                            padding: 5px 5px 15px;
                          "
                        >
                          {{qr_text}}
                        </div>

                        <div
                          class="qr-wrap"
                          style="
                            text-align: center;
                            padding: 0 10px;
                            width: 100%;
                            max-width: 180px;
                            box-sizing: border-box;
                            margin: 0 auto;
                          "
                        >
                          [pwe_qr_img]
                        </div>

                        <div
                          style="
                            color: #ffffff;
                            font-family: Arial, Helvetica, sans-serif;
                            font-size: 11px;
                            line-height: 16px;
                            font-weight: 400;
                            text-align: center;
                            padding: 15px 5px 5px;
                          "
                        >
                          {{qr_help}}
                        </div>
                      </td>
                    </tr>
                  </table>
                </td>

                <!-- ============================================= -->
                <!-- CTA -->
                <!-- ============================================= -->

                <td
                  class="hybrid-cell"
                  width="50%"
                  valign="top"
                  style="
                    display: table-cell;
                    width: 50%;
                    vertical-align: top;
                    box-sizing: border-box;
                    padding: 4px;
                  "
                >
                  <table
                    role="presentation"
                    width="100%"
                    height="100%"
                    cellpadding="0"
                    cellspacing="0"
                    border="0"
                    style="
                      width: 100%;
                      height: 100%;
                      box-sizing: border-box;
                      border-radius: 5px;
                    "
                  >
                    <tr>
                      <td
                        valign="top"
                        style="
                          height: 100%;
                          padding: 31px 20px;
                          
                            target= 'white'];
                          border-radius: 5px;
                        "
                      >
                        <div
                          style="
                            color: [trade_fair_accent];
                            font-family: Arial, Helvetica, sans-serif;
                            font-size: 14px;
                            line-height: 22px;
                            font-weight: 700;
                            text-align: center;
                            padding: 10px 5px;
                          "
                        >
                          {{cta_text}}
                        </div>

                        <div style="text-align: center; padding: 29px 0">
                          <a
                            href="https://[pwe_lang_domain lang='{{lang}}']/"
                            target="_blank"
                            style="
                              display: inline-block;
                              background: [trade_fair_accent];
                              color: #ffffff;
                              font-family: Arial, Helvetica, sans-serif;
                              font-size: 14px;
                              font-weight: 700;
                              line-height: 20px;
                              text-decoration: none;
                              padding: 12px 24px;
                              border-radius: 3px;
                            "
                          >
                            {{cta_button_text}}
                          </a>
                        </div>

                        <div
                          style="
                            color: #222222;
                            font-family: Arial, Helvetica, sans-serif;
                            font-size: 16px;
                            line-height: 21px;
                            font-weight: 600;
                            text-align: center;
                            padding: 5px 5px;
                            overflow-wrap: anywhere;
                          "
                        >
                          [pwe_lang_domain lang='{{lang}}']/
                        </div>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
            </table>
          </mj-raw>
        </mj-column>
      </mj-section>

      <!-- ===================================================== -->
      <!-- DATA -->
      <!-- ===================================================== -->

      <mj-section padding="0 6px 20px">
        <mj-column
          background-color="[color_mix base= 'accent' percent= '90' target= 'white']"
          border-radius="5px"
          padding="18px"
        >
          <mj-text
            align="center"
            color="#1E222B"
            font-size="14px"
            line-height="20px"
            font-weight="700"
            padding="0 0 10px"
          >
            {{event_date_text}}
          </mj-text>

          <mj-text
            css-class="mobile-date"
            align="center"
            color="#1E222B"
            font-size="22px"
            line-height="28px"
            font-weight="700"
            padding="0"
          >
            [trade_fair_date_multilang]
          </mj-text>

          <mj-text align="center" padding="20px 0 0">
            <a
              href="https://[trade_fair_domainadress]/{{add_to_calendar_url}}"
              target="_blank"
              style="
                display: inline-block;
                width: 90%;
                max-width: 100%;
                box-sizing: border-box;
                background: [trade_fair_accent];
                color: #ffffff;
                font-family: Arial, Helvetica, sans-serif;
                font-size: 14px;
                font-weight: 700;
                line-height: 20px;
                text-decoration: none;
                padding: 12px 24px;
                border-radius: 3px;
              "
            >
              {{add_to_calendar_text}}
            </a>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- ==================================================== -->
      <!-- CONTACT -->
      <!-- ==================================================== -->

      <mj-section padding="0 6px 20px">
        <mj-column vertical-align="middle">
          <mj-text
            align="center"
            color="#1e1e1e"
            font-size="13px"
            line-height="20px"
            padding="12px"
          >
            {{contact_text}}
          </mj-text>
        </mj-column>
        <mj-column 
          vertical-align="middle"
          background-color="[trade_fair_accent]"
          border-radius="5px"
          padding="20px 8px"
        >
          <mj-text
            align="center"
            color="#ededed"
            font-size="13px"
            line-height="20px"
            padding="2px"
          >
              {{contact_email_label}}
              <a
                href="mailto:[trade_fair_contact_email_vip]"
                style="
                  color: #ffffff;
                  text-decoration: underline;
                  font-weight: 700;
                  letter-spacing: 1px;
                "
                >[trade_fair_contact_email_vip]</a
              >
          </mj-text>
          <mj-text
            align="center"
            color="#ededed"
            font-size="13px"
            line-height="20px"
            padding="2px"
          >
              {{contact_phone_label}}
              <a
                href="tel:[trade_fair_contact_phone_vip]"
                style="
                  color: #ffffff;
                  text-decoration: underline;
                  font-weight: 700;
                  letter-spacing: 1px;
                "
                >[trade_fair_contact_phone_vip]</a
              >
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- ===================================================== -->
      <!-- OBIEKT -->
      <!-- ===================================================== -->

      <mj-section padding="0 6px">
        <mj-column>
          <mj-image
            src="https://[trade_fair_domainadress]/wp-content/plugins/pwe-media/media/notifications/email-footer/background_footer.jpg"
            padding="0"
            border-radius="5px 5px 0 0"
          />
        </mj-column>
      </mj-section>

      <!-- ===================================================== -->
      <!-- STATYSTYKI -->
      <!-- ===================================================== -->

      <mj-section padding="0 6px">
        <mj-column width="100%" padding="12px 10px" background-color="#1e1e1e">
          <mj-raw>
            <tr>
              <td
                align="center"
                bgcolor="#1e1e1e"
                style="
                  padding: 0;
                  font-size: 0;
                  text-align: center;
                  background: #1e1e1e;
                "
              >
                <div style="width: 100%; font-size: 0; text-align: center">
                  <!-- ================================================= -->
                  <!-- GRUPA 1: STAT 1 + 2 -->
                  <!-- ================================================= -->

                  <div
                    class="stat-group"
                    style="
                      display: inline-block;
                      vertical-align: top;
                      width: 50%;
                      box-sizing: border-box;
                      text-align: center;
                    "
                  >
                    <!-- ===================== -->
                    <!-- STAT 1 -->
                    <!-- ===================== -->

                    <div
                      style="
                        display: inline-block;
                        vertical-align: top;
                        width: 50%;
                        box-sizing: border-box;
                        padding: 4px;
                      "
                    >
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        bgcolor="#1e1e1e"
                        style="
                          width: 100%;
                          border-collapse: separate;
                          border-spacing: 0;
                          background: #1e1e1e;
                          border: 1px solid #505050;
                          border-radius: 12px;
                        "
                      >
                        <tbody>
                          <tr>
                            <td
                              valign="middle"
                              bgcolor="#1e1e1e"
                              style="
                                height: 90px;
                                padding: 10px;
                                background: #1e1e1e;
                                border-radius: 12px;
                                vertical-align: middle;
                              "
                            >
                              <table
                                role="presentation"
                                width="100%"
                                cellpadding="0"
                                cellspacing="0"
                                border="0"
                                style="width: 100%; border-collapse: collapse"
                              >
                                <tbody>
                                  <tr>
                                    <td align="right" style="padding: 0 0 8px">
                                      <img
                                        src="https://[trade_fair_domainadress]/wp-content/plugins/pwe-media/media/notifications/exhibitors_icon.png"
                                        width="30"
                                        alt=""
                                        style="
                                          display: block;
                                          width: 30px;
                                          height: auto;
                                          margin-left: auto;
                                          border: 0;
                                        "
                                      />
                                    </td>
                                  </tr>

                                  <tr>
                                    <td
                                      align="left"
                                      style="
                                        padding: 0;
                                        color: #ffffff;
                                        font-family:
                                          Arial, Helvetica, sans-serif;
                                        font-size: 27px;
                                        line-height: 30px;
                                        font-weight: 700;
                                        text-align: left;
                                      "
                                    >
                                      2000+
                                    </td>
                                  </tr>

                                  <tr>
                                    <td
                                      align="left"
                                      style="
                                        padding: 3px 0 0;
                                        color: #ffffff;
                                        font-family:
                                          Arial, Helvetica, sans-serif;
                                        font-size: 9px;
                                        line-height: 12px;
                                        font-weight: 700;
                                        text-align: left;
                                      "
                                    >
                                      {{exhibitors_text}}
                                    </td>
                                  </tr>
                                </tbody>
                              </table>
                            </td>
                          </tr>
                        </tbody>
                      </table>
                    </div>

                    <!-- ===================== -->
                    <!-- STAT 2 -->
                    <!-- ===================== -->

                    <div
                      style="
